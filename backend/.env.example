# ==============================================================================
# CONFIGURACION DE ENTORNO - BACKEND PLANTA
# Copiar este archivo a '.env' y configurar con los valores correspondientes.
# NUNCA commitear el archivo '.env' real al repositorio.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de Datos Interna (SQL Server)
# ------------------------------------------------------------------------------
DB_SERVER=.\SQLEXPRESS
DB_NAME=GestionDeposito
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUSTED_CONNECTION=yes
DB_TRUST_SERVER_CERTIFICATE=yes
# Si se utiliza autenticación SQL Server (UID/PWD), descomentar y completar:
# DB_USER=sa
# DB_PASSWORD=tu_password_seguro

# ------------------------------------------------------------------------------
# 2. Seguridad y JWT
# ------------------------------------------------------------------------------
# Clave criptográfica para firma de tokens de sesión (mínimo 32 caracteres)
SECRET_KEY=cambiar_por_clave_aleatoria_super_segura_de_produccion_2026

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Segregación y Sincronización Nodo CL2
# ------------------------------------------------------------------------------
# Activar la sincronización con el nodo de depósito CL2 (true / false)
CL2_SYNC_ENABLED=false

# URL base del endpoint de sincronización del nodo CL2
CL2_API_URL=https://nodo-cl2.empresa.local/api/v1

# Token / Clave de autenticación para llamadas hacia el nodo CL2
CL2_API_KEY=tu_token_de_servicio_nodo_cl2

# Secreto compartido para firma y validación de eventos (HMAC SHA-256)
CL2_HMAC_SECRET=clave_secreta_compartida_hmac_sync_cl2

# Intervalo en segundos para consultar cambios hacia Supabase (1200 = 20 minutos)
CL2_SYNC_INTERVAL_SECONDS=1200


